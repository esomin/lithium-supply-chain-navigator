{
    "name": "mineral-chain-navigator",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "./dev.sh",
        "build": "npm run build --workspaces",
        "test": "vitest --run",
        "test:watch": "vitest",
        "lint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
        "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
        "fetch:production": "npm --workspace=@navigator/pipeline run etl:extract-lithium"
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "dotenv": "^17.4.2",
        "eslint": "^8.57.0",
        "fast-check": "^3.15.0",
        "prettier": "^3.2.0",
        "typescript": "^5.4.0",
        "vitest": "^1.6.0"
    },
    "overrides": {
        "tsx": "4.15.0"
    }
}